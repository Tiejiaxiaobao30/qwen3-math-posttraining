# Frozen evidence hashes refer to exact archived bytes, including line endings.
results/** -text whitespace=cr-at-eol
data/official/** -text whitespace=cr-at-eol
reports/final/** -text whitespace=cr-at-eol
scripts/eval_official_test.py -text whitespace=cr-at-eol
# Keep the pre-test parser and prompt hashes portable on Windows checkouts.
scripts/evaluator.py text eol=lf
configs/sft_prompt.txt text eol=lf
# V2 source logs, metrics and provenance retain the archived bytes on every OS.
reports/v2/** -text whitespace=cr-at-eol
configs/v2*.json -text whitespace=cr-at-eol
# Preserve original terminal progress whitespace in imported evidence.
reports/v2/source_logs/** -text whitespace=-blank-at-eol,cr-at-eol
reports/v2/environment_snapshot.txt -text whitespace=-blank-at-eol,cr-at-eol
